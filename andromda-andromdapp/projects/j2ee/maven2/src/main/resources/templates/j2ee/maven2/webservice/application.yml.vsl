server:
    port: 8085
    servlet:
        context-path: ${CONTEXT_PATH:/$applicationId/api/}
    http2:
        enabled: true
spring:
    thymeleaf:
        cache: false
    threads:
        virtual:
            enabled: true
    mvc:
        format:
            date: iso
            date-time: iso
            time: HH:mm:ss
        pathmatch:
            matching-strategy: ANT_PATH_MATCHER