server:
    port: 8085
    servlet:
        context-path: /
    http2:
        enabled: true
spring:
    threads:
        virtual:
            enabled: true
    thymeleaf:
        cache: false
    threads:
        virtual:
            enabled: true
    mvc:
        format:
            date: iso
            date-time: iso
            time: HH:mm:ss
        pathmatch:
            matching-strategy: ANT_PATH_MATCHER
#if($secure)
app:
    security:
        permit: /public/**
#end