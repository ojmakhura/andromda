    private String toFriendlyMessage(String message) {
#foreach($operation in $service.operations)
#foreach ($argument in $operation.arguments)
#set($argumentPhrase = "$stringUtils.toPhrase($argument.name)")
#if ($argument.required && !$argument.type.primitive)
        if (message.contains(".${operation.name}(") && message.contains("'${argument.name}'")) {
            return "$stringUtils.capitalize($argumentPhrase) is required.";
        }

#end
#end
#if (!$argument.many && !$argument.type.enumeration && !$argument.type.entityMetaType)
#foreach ($attribute in $argument.type.getAttributes(true))
