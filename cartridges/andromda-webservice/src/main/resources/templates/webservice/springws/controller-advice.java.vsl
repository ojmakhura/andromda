     */
    @ExceptionHandler(${ref.targetElement.fullyQualifiedName}Exception.class)
    public ResponseEntity<ProblemDetail> handle${ref.targetElement.name}Exception(${ref.targetElement.fullyQualifiedName}Exception ex, WebRequest request) {

        String message = ex.getMessage() == null ? "" : ex.getMessage();
        ${applicationPackage}.ValidationMapping mapping = findMapping(message).orElse(null);
        String friendly = mapping == null
                ? FALLBACK_MESSAGE
                : mapping.friendlyMessage();
        HttpStatus status = mapping == null
                ? HttpStatus.INTERNAL_SERVER_ERROR
                : mapping.status();

        String type = mapping == null
                ? "service-error"
