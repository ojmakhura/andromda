import ${applicationPackage}.exception.ApiErrorResponse;
import ${service.packageName}.${service.name}Exception;

import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.ExceptionHandler;
import org.springframework.web.bind.annotation.RestControllerAdvice;

import java.time.LocalDateTime;
import java.util.ArrayList;
import java.util.List;

/**
$service.getDocumentation(" * ")
 */
@RestControllerAdvice
public class ${service.name}ExceptionHandler 
{
    @ExceptionHandler(${service.name}Exception.class)
    public ResponseEntity<ApiErrorResponse> handle${service.name}Exception(${service.name}Exception ex) {
        ApiErrorResponse error = new ApiErrorResponse(
                HttpStatus.INTERNAL_SERVER_ERROR.value(),
                ex.getMessage(),
                LocalDateTime.now()
        );

        List<String> details = new ArrayList<>();

        if (ex.getCause() != null) {

            Throwable cause = ex.getCause();
            details.add(cause.getMessage());

            if (cause.getCause() != null) {
                details.add(cause.getCause().getMessage());

                if (cause.getCause().getCause() != null) {
                    details.add(cause.getCause().getCause().getMessage());
                }
            }
        }

        error.setDetails(details);

        return new ResponseEntity<>(error, HttpStatus.INTERNAL_SERVER_ERROR);
    }
}
